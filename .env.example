# ============================================================
# Telegram  (required)
# ============================================================
# Bot token from @BotFather
BOT_TOKEN=

# MTProto credentials from https://my.telegram.org (required for 2 GB downloads)
API_ID=
API_HASH=

# Admin numeric user ids (comma separated) — can use /stats and /model
ADMIN_USER_IDS=

# Restrict the bot to specific user ids (comma separated). Empty = public.
ALLOWED_USER_IDS=

# ============================================================
# Files & queue
# ============================================================
MAX_UPLOAD_SIZE=2147483648        # 2 GB
TEMP_DIRECTORY=/tmp/jobs
DELETE_AFTER_SEND=true
MAX_CONCURRENT_JOBS=1             # ASR is CPU-heavy; raise only with more cores
QUEUE_SIZE=20
USER_COOLDOWN_SECONDS=20
JOB_TIMEOUT_MINUTES=180

# ============================================================
# Speech recognition (faster-whisper)
# ============================================================
# tiny | base | small | medium | large-v2 | large-v3 | large-v3-turbo | turbo
# CPU hosts: small/base recommended. GPU hosts: large-v3.
WHISPER_MODEL=small
WHISPER_DEVICE=auto               # auto | cpu | cuda
WHISPER_COMPUTE=auto              # auto | int8 | float16 | float32
WHISPER_BEAM_SIZE=5
VAD_FILTER=true                   # skip silence via voice activity detection
AUDIO_NORMALIZE=true              # ffmpeg loudness normalization

# ============================================================
# Persian translation — AI provider layer
# Any OpenAI-compatible API works (OpenAI, OpenRouter, Gemini gateways,
# Azure, Ollama, vLLM, LM Studio, custom REST...).
# ============================================================
TRANSLATE_ENABLED=true
TARGET_LANGUAGE=fa

# Simple single-provider setup:
AI_BASE_URL=
AI_API_KEY=
# Comma-separated fallback chain — first model is primary:
AI_MODELS=
# Keep generous for reasoning models (hidden thinking consumes tokens):
AI_MAX_TOKENS=8192

# Advanced multi-provider setup (optional, overrides nothing — merged):
# PROVIDERS_JSON=[{"name":"openrouter","base_url":"https://openrouter.ai/api/v1","api_key":"sk-...","models":["model-a","model-b"],"priority":1},{"name":"local-ollama","base_url":"http://ollama:11434/v1","api_key":"","models":["qwen2.5"],"priority":2}]

TRANSLATION_WORKERS=4             # parallel chunk translators
TRANSLATION_CHUNK_SIZE=15         # subtitle lines per request (smaller = safer for reasoning models)

# ============================================================
# Subtitle output
# ============================================================
SUBTITLE_FORMATS=srt              # any of: srt,vtt,ass,txt
MAX_CHARS_PER_LINE=42
MAX_SUBTITLE_LINES=2
MAX_CUE_DURATION=6.0
RTL_MARKS=true                    # fixes punctuation side in most players

# ============================================================
# Misc
# ============================================================
LOG_LEVEL=INFO
# PORT is injected by Railway automatically (health endpoint binds to it)
